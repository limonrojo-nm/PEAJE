# Configuración de peaje-core para esta Raspberry. Copiar a .env y ajustar.
# La lee pydantic-settings al arrancar (a mano o como servicio de systemd), y
# cualquier variable de entorno con el mismo nombre la pisa.
# Todas las opciones: README.md y src/peaje_core/config.py.

# Impresora por USB: los IDs salen de `lsusb` (o GET /printer/connected).
PEAJE_PRINTER_BACKEND=usb
PEAJE_PRINTER_USB_VENDOR_ID=0x0483
PEAJE_PRINTER_USB_PRODUCT_ID=0x5840

# Ancho del cabezal en puntos: 58 mm ≈ 384, 80 mm ≈ 576.
PEAJE_PRINTER_DOTS_WIDTH=576

# Comando ESC/POS para el dibujo. La Aclas PP7 sólo entiende bitImageColumn.
PEAJE_PRINTER_IMAGE_IMPL=bitImageColumn

# De dónde se sirve la app (CORS). Sin esto el navegador bloquea el envío.
PEAJE_ALLOWED_ORIGINS=https://jav1stro.github.io
